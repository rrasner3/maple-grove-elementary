---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/staff', label: 'Staff' },
  { href: '/admissions', label: 'Admissions' },
  { href: '/news', label: 'News' },
  { href: '/contact', label: 'Contact' },
];

const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="bg-white border-b border-maple-100 sticky top-0 z-30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 group">
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-maple-600 text-white font-display text-lg group-hover:bg-maple-700 transition-colors">M</span>
      <span class="font-display text-xl text-maple-700 leading-tight">
        Maple Grove
        <span class="block text-xs uppercase tracking-widest text-gray-500 font-sans">Elementary</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="hidden md:flex items-center gap-1 text-sm font-medium">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-md transition-colors',
                isActive(item.href)
                  ? 'text-maple-700 bg-maple-50'
                  : 'text-gray-700 hover:text-maple-700 hover:bg-cream-100',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer p-2 rounded-md text-gray-700 hover:bg-cream-100">
          <span class="sr-only">Open menu</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <ul class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-maple-100 py-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block px-4 py-2 hover:bg-cream-100',
                  isActive(item.href) ? 'text-maple-700 font-semibold' : 'text-gray-700',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

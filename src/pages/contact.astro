---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <section class="bg-cream-100/50 border-b border-maple-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
      <p class="text-xs uppercase tracking-widest text-maple-600 font-semibold">Get in touch</p>
      <h1 class="font-display text-4xl sm:text-5xl text-maple-800 mt-3">We'd love to hear from you.</h1>
      <p class="text-lg text-gray-700 leading-relaxed mt-6">
        The front office is the best place to start for general questions, tour requests,
        or anything else.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 grid md:grid-cols-2 gap-10">
    <div>
      <h2 class="font-display text-2xl text-gray-900 mb-4">Front office</h2>
      <ul class="space-y-3 text-gray-700">
        <li>
          <span class="block text-xs uppercase tracking-widest text-maple-600 font-semibold">Address</span>
          123 Maple Lane<br />Riverdale, OR 97000
        </li>
        <li>
          <span class="block text-xs uppercase tracking-widest text-maple-600 font-semibold">Phone</span>
          <a href="tel:+15550100123" class="hover:text-maple-700">(555) 010-0123</a>
        </li>
        <li>
          <span class="block text-xs uppercase tracking-widest text-maple-600 font-semibold">Email</span>
          <a href="mailto:hello@maplegrove.example" class="hover:text-maple-700">hello@maplegrove.example</a>
        </li>
        <li>
          <span class="block text-xs uppercase tracking-widest text-maple-600 font-semibold">Office hours</span>
          Monday &ndash; Friday, 7:30am &ndash; 4:00pm
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-display text-2xl text-gray-900 mb-4">Send us a note</h2>
      <p class="text-gray-700 mb-4">
        For the quickest reply, email us directly. Pick the option that fits best:
      </p>
      <div class="space-y-3">
        <a
          href="mailto:admissions@maplegrove.example?subject=Tour%20request"
          class="block bg-white rounded-2xl border border-maple-100 p-5 shadow-sm hover:border-maple-300 transition-colors"
        >
          <span class="font-display text-lg text-gray-900">Request a tour</span>
          <span class="block text-sm text-gray-600 mt-1">admissions@maplegrove.example</span>
        </a>
        <a
          href="mailto:hello@maplegrove.example?subject=General%20inquiry"
          class="block bg-white rounded-2xl border border-maple-100 p-5 shadow-sm hover:border-maple-300 transition-colors"
        >
          <span class="font-display text-lg text-gray-900">General questions</span>
          <span class="block text-sm text-gray-600 mt-1">hello@maplegrove.example</span>
        </a>
        <a
          href="mailto:office@maplegrove.example?subject=Current%20family%20question"
          class="block bg-white rounded-2xl border border-maple-100 p-5 shadow-sm hover:border-maple-300 transition-colors"
        >
          <span class="font-display text-lg text-gray-900">Current families</span>
          <span class="block text-sm text-gray-600 mt-1">office@maplegrove.example</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

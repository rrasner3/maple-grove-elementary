---
interface Props {
  href: string;
  title: string;
  date: Date;
  summary: string;
  tags?: string[];
}

const { href, title, date, summary, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="bg-white rounded-2xl border border-maple-100 p-6 shadow-sm hover:shadow-md transition-shadow">
  <time class="text-xs uppercase tracking-widest text-maple-600 font-semibold">
    {formattedDate}
  </time>
  <h3 class="font-display text-xl mt-2 mb-2 text-gray-900">
    <a href={href} class="hover:text-maple-700 transition-colors">{title}</a>
  </h3>
  <p class="text-gray-600 leading-relaxed text-sm mb-4">{summary}</p>
  <div class="flex items-center justify-between">
    <div class="flex flex-wrap gap-1">
      {tags.map((tag) => (
        <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-cream-100 text-maple-700">
          {tag}
        </span>
      ))}
    </div>
    <a href={href} class="text-sm font-semibold text-maple-700 hover:text-maple-800">
      Read more &rarr;
    </a>
  </div>
</article>
